# Copy to .env. Local development uses SQLite and local disk; no paid model calls by default.
DATABASE_URL=sqlite:///.data/creator.db
DATA_DIR=.data
WEB_ORIGIN=http://localhost:3000
APP_ENV=development
# Required in production (at least 32 random characters).
# JWT_SECRET=
# PostgreSQL: postgresql+psycopg://creator:change-me@localhost:5432/creator
REDIS_URL=redis://localhost:6379/0
GENERATION_MODE=template
# Optional real AI mode. Requires explicit creator consent and budget reservation.
# GENERATION_MODE=openai
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_ID=
# MODEL_INPUT_CENTS_PER_MILLION=
# MODEL_OUTPUT_CENTS_PER_MILLION=
# MODEL_MAX_OUTPUT_TOKENS=1800
COOKIE_SECURE=false

# Model keys saved through the UI use a separate Fernet master key.
# Required in production; generated privately in .data/model-encryption-key for development.
# MODEL_ENCRYPTION_KEY=
MODEL_ALLOWED_HOSTS=api.openai.com

# Optional local Kokoro (installed separately; no automatic downloads or cloud fallback)
# KOKORO_PYTHON=D:/推广助手/.data/tts-runtime/Scripts/python.exe
# KOKORO_MODEL_DIR=D:/推广助手/.data/story-assets/kokoro-multi-lang-v1_0

# Optional expressive local Qwen 1.7B CustomVoice; isolated Python/CUDA installation required
# QWEN_TTS_PYTHON=D:/推广助手/.data/qwen-clean-runtime/Scripts/python.exe
# QWEN_TTS_MODEL_DIR=D:/推广助手/.data/qwen-model
