{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/creator/runtime-receipt.schema.json",
  "title": "Creator runtime receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_time",
    "trace_id",
    "creator_run_id",
    "stage",
    "status",
    "release_id",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "creator_run_id": {
      "type": "string",
      "minLength": 1
    },
    "content_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "video_project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "shot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "render_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "ok",
        "error",
        "skipped",
        "cancelled",
        "unknown"
      ]
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "diagnostic_note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    }
  }
}
