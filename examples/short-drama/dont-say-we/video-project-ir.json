  "subtitles": [
    {
      "cue_id": "01-question",
      "start_frame": 18,
      "end_frame": 76,
      "text": "别说我们。你做了什么？"
    },
    {
      "cue_id": "02-small",
      "start_frame": 104,
      "end_frame": 200,
      "text": "我……就改了个按钮。"
    },
    {
      "cue_id": "03-why",
      "start_frame": 220,
      "end_frame": 256,
      "text": "那为什么改？"
    },
    {
      "cue_id": "04-problem",
      "start_frame": 285,
      "end_frame": 374,
      "text": "有人试了三次，都没找到入口。"
    },
    {
      "cue_id": "05-choice",
      "start_frame": 402,
      "end_frame": 512,
      "text": "我把欢迎页拿掉了，入口放到第一屏。"
    },
    {
      "cue_id": "06-after",
      "start_frame": 540,
      "end_frame": 566,
      "text": "后来呢？"
    },
    {
      "cue_id": "07-result",
      "start_frame": 586,
      "end_frame": 632,
      "text": "她一次就找到了。"
    },
    {
      "cue_id": "08-missing",
      "start_frame": 675,
      "end_frame": 740,
      "text": "这些，为什么简历里没有？"
    },
    {
      "cue_id": "09-too-small",
      "start_frame": 770,
      "end_frame": 856,
      "text": "我以为……太小了。"
    },
    {
      "cue_id": "10-again",
      "start_frame": 906,
      "end_frame": 959,
      "text": "那从这里，重新讲。"
    },
    {
      "cue_id": "11-start",
      "start_frame": 999,
      "end_frame": 1112,
      "text": "好。这次，我知道为什么。"
    }
  ],
