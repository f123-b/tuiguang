{
  "$defs": {
    "AudioTrack": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "voiceover",
            "music"
          ],
          "title": "Role",
          "type": "string"
        },
        "start_frame": {
          "default": 0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "duration_frames": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Duration Frames",
          "type": "integer"
        },
        "source_start_frame": {
          "default": 0,
          "maximum": 216000,
          "minimum": 0,
          "title": "Source Start Frame",
          "type": "integer"
        },
        "volume_percent": {
          "default": 100,
          "maximum": 200,
          "minimum": 0,
          "title": "Volume Percent",
          "type": "integer"
        },
        "loop": {
          "default": false,
          "title": "Loop",
          "type": "boolean"
        }
      },
      "required": [
        "track_id",
        "asset_id",
        "role",
        "duration_frames"
      ],
      "title": "AudioTrack",
      "type": "object"
    },
    "FrameCrop": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0,
          "maximum": 75,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "default": 0,
          "maximum": 75,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "default": 100,
          "maximum": 100,
          "minimum": 25,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 100,
          "maximum": 100,
          "minimum": 25,
          "title": "Height",
          "type": "integer"
        }
      },
      "title": "FrameCrop",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "style": {
          "default": "classic",
          "enum": [
            "classic",
            "studio"
          ],
          "title": "Style",
          "type": "string"
        },
        "theme": {
          "default": "ink",
          "enum": [
            "ink",
            "paper"
          ],
          "title": "Theme",
          "type": "string"
        },
        "accent": {
          "default": "#B7F56B",
          "pattern": "^#[a-fA-F0-9]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "brand_label": {
          "default": "",
          "maxLength": 40,
          "title": "Brand Label",
          "type": "string"
        },
        "transition": {
          "default": "clean",
          "enum": [
            "clean",
            "dip"
          ],
          "title": "Transition",
          "type": "string"
        },
        "audio_finish": {
          "default": true,
          "title": "Audio Finish",
          "type": "boolean"
        }
      },
      "title": "Presentation",
      "type": "object"
    },
    "SceneDesign": {
      "additionalProperties": false,
      "properties": {
        "motion": {
          "default": "push",
          "enum": [
            "still",
            "push",
            "pan"
          ],
          "title": "Motion",
          "type": "string"
        },
        "layout": {
          "default": "auto",
          "enum": [
            "auto",
            "hero",
            "features",
            "steps",
            "screen",
            "focus",
            "closing",
            "diagram",
            "montage",
            "comic"
          ],
          "title": "Layout",
          "type": "string"
        },
        "kicker": {
          "default": "",
          "maxLength": 40,
          "title": "Kicker",
          "type": "string"
        },
        "headline": {
          "default": "",
          "maxLength": 80,
          "title": "Headline",
          "type": "string"
        },
        "supporting": {
          "default": "",
          "maxLength": 240,
          "title": "Supporting",
          "type": "string"
        },
        "points": {
          "items": {
            "maxLength": 90,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "Points",
          "type": "array"
        },
        "crop": {
          "$ref": "#/$defs/FrameCrop"
        }
      },
      "title": "SceneDesign",
      "type": "object"
    },
    "Shot": {
      "additionalProperties": false,
      "properties": {
        "shot_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Shot Id",
          "type": "string"
        },
        "shot_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Shot Revision",
          "type": "integer"
        },
        "provider": {
          "enum": [
            "pillow_mg",
            "ffmpeg_media",
            "comfy_wan",
            "blender"
          ],
          "title": "Provider",
          "type": "string"
        },
        "kind": {
          "enum": [
            "motion_graphics",
            "screen_demo",
            "montage",
            "ai_creative_scene",
            "three_d"
          ],
          "title": "Kind",
          "type": "string"
        },
        "duration_frames": {
          "maximum": 1800,
          "minimum": 15,
          "title": "Duration Frames",
          "type": "integer"
        },
        "caption": {
          "default": "",
          "maxLength": 180,
          "title": "Caption",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "trim_start_frame": {
          "default": 0,
          "maximum": 216000,
          "minimum": 0,
          "title": "Trim Start Frame",
          "type": "integer"
        },
        "speed_percent": {
          "default": 100,
          "maximum": 400,
          "minimum": 25,
          "title": "Speed Percent",
          "type": "integer"
        },
        "freeze_end_frames": {
          "default": 0,
          "maximum": 1800,
          "minimum": 0,
          "title": "Freeze End Frames",
          "type": "integer"
        },
        "design": {
          "$ref": "#/$defs/SceneDesign"
        },
        "narration_text": {
          "default": "",
          "maxLength": 600,
          "title": "Narration Text",
          "type": "string"
        }
      },
      "required": [
        "shot_id",
        "provider",
        "kind",
        "duration_frames"
      ],
      "title": "Shot",
      "type": "object"
    },
    "Subtitle": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Cue Id",
          "type": "string"
        },
        "start_frame": {
          "maximum": 3600,
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "maximum": 3600,
          "minimum": 1,
          "title": "End Frame",
          "type": "integer"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "cue_id",
        "start_frame",
        "end_frame",
        "text"
      ],
      "title": "Subtitle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brand_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Brand Id",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "width": {
      "default": 1920,
      "enum": [
        1080,
        1920
      ],
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "default": 1080,
      "enum": [
        1080,
        1920
      ],
      "title": "Height",
      "type": "integer"
    },
    "fps": {
      "const": 30,
      "default": 30,
      "title": "Fps",
      "type": "integer"
    },
    "shots": {
      "items": {
        "$ref": "#/$defs/Shot"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Shots",
      "type": "array"
    },
    "audio_tracks": {
      "items": {
        "$ref": "#/$defs/AudioTrack"
      },
      "maxItems": 8,
      "title": "Audio Tracks",
      "type": "array"
    },
    "subtitles": {
      "items": {
        "$ref": "#/$defs/Subtitle"
      },
      "maxItems": 100,
      "title": "Subtitles",
      "type": "array"
    },
    "preview_required": {
      "default": false,
      "title": "Preview Required",
      "type": "boolean"
    },
    "presentation": {
      "$ref": "#/$defs/Presentation"
    }
  },
  "required": [
    "brand_id",
    "name",
    "shots"
  ],
  "title": "VideoInput",
  "type": "object"
}